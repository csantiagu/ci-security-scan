{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "description": "Keeps the pinned actions, scanner images and clean demo current. Never touches the vulnerable demo.",
  "ignorePaths": ["demo/vulnerable/**"],
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Scanner images in scan.yml, pinned as name:tag@sha256:digest",
      "managerFilePatterns": ["/^\\.github/workflows/scan\\.yml$/"],
      "matchStrings": [
        "_IMAGE: (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Versions marked with a `# renovate:` comment",
      "managerFilePatterns": ["/^\\.github/workflows/scan\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "One PR for all scanner updates",
      "matchFileNames": [".github/workflows/scan.yml"],
      "matchManagers": ["custom.regex"],
      "groupName": "scanners"
    }
  ]
}
